generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["lcc"]
}

model User {
  id                  String                  @id @default(cuid())
  email               String                  @unique
  passwordHash        String
  name                String
  role                String                  @default("member")
  timezone            String                  @default("America/Chicago")
  createdAt           DateTime                @default(now())
  committees          CommitteeMember[]
  discussions         Discussion[]
  posts               Post[]
  tasks               Task[]                  @relation("assignee")
  files               CommitteeFile[]
  devices             Device[]
  mobileSessions      MobileSession[]
  notificationPrefs   NotificationPreference?
  notificationLog     NotificationLog[]
  scheduledNotifs     ScheduledNotification[]

  @@map("lcc_users")
  @@schema("lcc")
}

model Committee {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String
  color       String            @default("#3B82F6")
  icon        String            @default("users")
  members     CommitteeMember[]
  events      Event[]
  discussions Discussion[]
  tasks       Task[]
  files       CommitteeFile[]

  @@map("lcc_committees")
  @@schema("lcc")
}

model CommitteeMember {
  id          String    @id @default(cuid())
  userId      String
  committeeId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@unique([userId, committeeId])
  @@map("lcc_committee_members")
  @@schema("lcc")
}

model Event {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  startTime   DateTime
  endTime     DateTime
  duration    Int       @default(60)
  timezone    String    @default("America/Chicago")
  recurring   Boolean   @default(false)
  meetingUrl  String?
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@map("lcc_events")
  @@schema("lcc")
}

model Discussion {
  id          String     @id @default(cuid())
  committeeId String?
  title       String
  authorId    String
  isPinned    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts       Post[]

  @@map("lcc_discussions")
  @@schema("lcc")
}

model Task {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  status      String    @default("todo")
  priority    String    @default("medium")
  progress    Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  color       String?
  url         String?
  assigneeId  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("lcc_tasks")
  @@schema("lcc")
}

model CommitteeFile {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  url         String
  type        String    @default("link")
  addedById   String
  createdAt   DateTime  @default(now())
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@map("lcc_committee_files")
  @@schema("lcc")
}

model Post {
  id           String     @id @default(cuid())
  discussionId String
  authorId     String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("lcc_posts")
  @@schema("lcc")
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  pushToken   String   @unique
  appVersion  String?
  deviceName  String?
  locale      String?
  timezone    String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_devices")
  @@schema("lcc")
}

model MobileSession {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_mobile_sessions")
  @@schema("lcc")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  String   @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lcc_notification_preferences")
  @@schema("lcc")
}

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String
  channel String
  title   String
  body    String
  payload String?
  sentAt  DateTime @default(now())
  status  String   @default("sent")
  error   String?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("lcc_notification_log")
  @@schema("lcc")
}

model ScheduledNotification {
  id           String    @id @default(cuid())
  userId       String
  channel      String
  title        String
  body         String
  payload      String?
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  source       String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([source])
  @@map("lcc_scheduled_notifications")
  @@schema("lcc")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([userId])
  @@map("lcc_password_reset_tokens")
  @@schema("lcc")
}

model Presenter {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  affiliation        String?
  jobTitle           String?
  pronouns           String?
  phone              String?

  role               String?
  talkTitle          String?
  talkAbstract       String?
  sessionFormat      String?
  sessionTrack       String?
  sessionLength      String?
  qaLength           String?
  coPresenters       String?
  preferredDay       String?
  learningObjectives String?
  honorariumAmount   Int?
  travelReimbursement Int?
  presenterMessage   String?

  bio                String?
  headshotData       Bytes?
  headshotMime       String?
  websiteUrl         String?
  linkedinUrl        String?
  twitterHandle      String?

  avNotes            String?
  needsMic           Boolean          @default(false)
  needsProjector     Boolean          @default(false)
  needsAudio         Boolean          @default(false)
  needsInternet      Boolean          @default(false)
  needsRecording     Boolean          @default(false)
  needsClicker       Boolean          @default(false)

  travelMode         String?
  travelOrigin       String?
  travelArrival      DateTime?
  travelDeparture    DateTime?
  needsHotel         Boolean          @default(false)
  hotelNotes         String?
  needsParking       Boolean          @default(false)

  dietary            String?
  allergies          String?
  accessibilityNeeds String?
  emergencyContact   String?

  agreedToRecord     Boolean          @default(false)
  agreedToPhoto      Boolean          @default(false)
  agreedToTerms      Boolean          @default(false)
  agreedToCe         Boolean          @default(false)
  agreedToHeadshot   Boolean          @default(false)
  policiesAcceptedAt DateTime?

  status             String           @default("invited")
  declineReason      String?
  requestedChanges   String?
  token              String           @unique
  invitedAt          DateTime         @default(now())
  confirmedAt        DateTime?
  lastSentAt         DateTime?
  adminNotes         String?
  invitedById        String?

  events             PresenterEvent[]

  @@map("lcc_presenters")
  @@schema("lcc")
}

model PresenterEvent {
  id          String    @id @default(cuid())
  presenterId String
  type        String
  meta        String?
  actorEmail  String?
  createdAt   DateTime  @default(now())
  presenter   Presenter @relation(fields: [presenterId], references: [id], onDelete: Cascade)

  @@map("lcc_presenter_events")
  @@schema("lcc")
}
