generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["lcc"]
}

model User {
  id                  String                  @id @default(cuid())
  email               String                  @unique
  passwordHash        String
  name                String
  role                String                  @default("member")
  timezone            String                  @default("America/Chicago")
  icalToken           String?                 @unique
  createdAt           DateTime                @default(now())
  committees          CommitteeMember[]
  discussions         Discussion[]
  posts               Post[]
  tasks               Task[]                  @relation("assignee")
  files               CommitteeFile[]
  devices             Device[]
  mobileSessions      MobileSession[]
  notificationPrefs   NotificationPreference?
  notificationLog     NotificationLog[]
  scheduledNotifs     ScheduledNotification[]
  discussionReads     DiscussionRead[]
  mentions            Mention[]
  availability        MemberAvailability[]
  availabilityExceptions AvailabilityException[]
  bookings            Booking[]

  @@map("lcc_users")
  @@schema("lcc")
}

model Committee {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String
  color       String            @default("#3B82F6")
  icon        String            @default("users")
  members     CommitteeMember[]
  events      Event[]
  discussions Discussion[]
  tasks       Task[]
  files       CommitteeFile[]

  @@map("lcc_committees")
  @@schema("lcc")
}

model CommitteeMember {
  id          String    @id @default(cuid())
  userId      String
  committeeId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@unique([userId, committeeId])
  @@map("lcc_committee_members")
  @@schema("lcc")
}

model Event {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  startTime   DateTime
  endTime     DateTime
  duration    Int       @default(60)
  timezone    String    @default("America/Chicago")
  recurring   Boolean   @default(false)
  meetingUrl  String?
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@map("lcc_events")
  @@schema("lcc")
}

model Discussion {
  id          String           @id @default(cuid())
  committeeId String?
  title       String
  authorId    String
  isPinned    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  committee   Committee?       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts       Post[]
  reads       DiscussionRead[]

  @@map("lcc_discussions")
  @@schema("lcc")
}

model Task {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  status      String    @default("todo")
  priority    String    @default("medium")
  progress    Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  color       String?
  url         String?
  assigneeId  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("lcc_tasks")
  @@schema("lcc")
}

model CommitteeFile {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  url         String
  type        String    @default("link")
  addedById   String
  createdAt   DateTime  @default(now())
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@map("lcc_committee_files")
  @@schema("lcc")
}

model Post {
  id           String     @id @default(cuid())
  discussionId String
  authorId     String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions     Mention[]

  @@map("lcc_posts")
  @@schema("lcc")
}

model DiscussionRead {
  id           String     @id @default(cuid())
  userId       String
  discussionId String
  lastReadAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@index([discussionId])
  @@map("lcc_discussion_reads")
  @@schema("lcc")
}

model Mention {
  id           String    @id @default(cuid())
  userId       String
  postId       String
  discussionId String
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([postId])
  @@map("lcc_mentions")
  @@schema("lcc")
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  pushToken   String   @unique
  appVersion  String?
  deviceName  String?
  locale      String?
  timezone    String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_devices")
  @@schema("lcc")
}

model MobileSession {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_mobile_sessions")
  @@schema("lcc")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  String   @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lcc_notification_preferences")
  @@schema("lcc")
}

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String
  channel String
  title   String
  body    String
  payload String?
  sentAt  DateTime @default(now())
  status  String   @default("sent")
  error   String?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("lcc_notification_log")
  @@schema("lcc")
}

model ScheduledNotification {
  id           String    @id @default(cuid())
  userId       String
  channel      String
  title        String
  body         String
  payload      String?
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  source       String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([source])
  @@map("lcc_scheduled_notifications")
  @@schema("lcc")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([userId])
  @@map("lcc_password_reset_tokens")
  @@schema("lcc")
}

model Presenter {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  affiliation        String?
  jobTitle           String?
  pronouns           String?
  phone              String?

  role               String?
  talkTitle          String?
  talkAbstract       String?
  sessionFormat      String?
  sessionTrack       String?
  sessionLength      String?
  qaLength           String?
  coPresenters       String?
  preferredDay       String?
  learningObjectives String?
  honorariumAmount   Int?
  travelReimbursement Int?
  presenterMessage   String?

  bio                String?
  headshotData       Bytes?
  headshotMime       String?
  websiteUrl         String?
  linkedinUrl        String?
  twitterHandle      String?
  facebookUrl        String?
  instagramUrl       String?
  otherSocialUrl     String?

  avNotes            String?
  needsMic           Boolean          @default(false)
  needsProjector     Boolean          @default(false)
  needsAudio         Boolean          @default(false)
  needsInternet      Boolean          @default(false)
  needsRecording     Boolean          @default(false)
  needsClicker       Boolean          @default(false)

  travelMode         String?
  travelOrigin       String?
  travelArrival      DateTime?
  travelDeparture    DateTime?
  needsHotel         Boolean          @default(false)
  hotelNotes         String?
  needsParking       Boolean          @default(false)

  dietary            String?
  allergies          String?
  accessibilityNeeds String?
  emergencyContact   String?

  agreedToRecord     Boolean          @default(false)
  agreedToPhoto      Boolean          @default(false)
  agreedToTerms      Boolean          @default(false)
  agreedToCe         Boolean          @default(false)
  agreedToHeadshot   Boolean          @default(false)
  policiesAcceptedAt DateTime?

  status             String           @default("invited")
  declineReason      String?
  requestedChanges   String?
  token              String           @unique
  invitedAt          DateTime         @default(now())
  confirmedAt        DateTime?
  lastSentAt         DateTime?
  adminNotes         String?
  invitedById        String?

  events             PresenterEvent[]

  @@map("lcc_presenters")
  @@schema("lcc")
}

model PresenterEvent {
  id          String    @id @default(cuid())
  presenterId String
  type        String
  meta        String?
  actorEmail  String?
  createdAt   DateTime  @default(now())
  presenter   Presenter @relation(fields: [presenterId], references: [id], onDelete: Cascade)

  @@map("lcc_presenter_events")
  @@schema("lcc")
}

model Attendee {
  id                   String          @id @default(cuid())
  email                String          @unique
  firstName            String
  lastName             String
  phone                String?
  affiliation          String?
  primaryLanguages     String?

  // AALB training cohort (medical-interpreter session), for imported students.
  // `cohort` is the label ("141"); `cohortOrder` is the numeric session number
  // used to sort newest-first and to filter by session. Null for non-students.
  cohort               String?
  cohortOrder          Int?

  attendanceMode       String?
  needsParking         Boolean?
  accessibilityNotes   String?
  dietary              String?
  notes                String?

  discountPercent      Int             @default(25)
  basePriceCents       Int?
  finalPriceCents      Int?

  // Shared discount code applied at registration (distinct from the
  // per-person discountPercent used for personal invites). Set when a code
  // is accepted; the redemption row is the authoritative audit record.
  discountCodeId       String?
  discountCode         String?
  discountCodeCents    Int?            @default(0)

  paid                 Boolean         @default(false)
  paidAt               DateTime?
  stripeSessionId      String?
  stripePaymentIntentId String?

  status               String          @default("queued")
  declineReason        String?

  inviteToken          String          @unique
  inviteMessage        String?
  inviteTemplate       String          @default("standard")
  invitedById          String?
  invitedAt            DateTime?
  lastSentAt           DateTime?
  viewedAt             DateTime?
  confirmedAt          DateTime?
  declinedAt           DateTime?

  // Created by the emails-only deliverability test, not a real invitee. Kept
  // out of the attendee pipeline and all email metrics so test traffic never
  // skews the numbers.
  isTest               Boolean         @default(false)

  // Set when the recipient uses one-click unsubscribe. Suppresses all further
  // sends to this person and is honored before every send.
  unsubscribedAt       DateTime?

  adminNotes           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime?       @updatedAt

  events               AttendeeEvent[]

  @@index([status])
  @@map("lcc_attendees")
  @@schema("lcc")
}

model AttendeeEvent {
  id         String   @id @default(cuid())
  attendeeId String
  type       String
  meta       String?
  actorEmail String?
  createdAt  DateTime @default(now())
  attendee   Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@map("lcc_attendee_events")
  @@schema("lcc")
}

model EmailQueue {
  id            String    @id @default(cuid())
  batchId       String?
  recipientType String    @default("attendee")
  recipientId   String?
  to            String
  subject       String
  html          String
  textBody      String?
  scheduledFor  DateTime
  status        String    @default("pending")
  attempts      Int       @default(0)
  sentAt        DateTime?
  lastError     String?
  resendId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([status, scheduledFor])
  @@index([batchId])
  @@index([recipientType, recipientId])
  @@map("lcc_email_queue")
  @@schema("lcc")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("lcc_system_settings")
  @@schema("lcc")
}

model Sponsor {
  id                    String         @id @default(cuid())
  companyName           String
  contactName           String
  contactEmail          String
  // Co-applicants merged into this profile: extra emails CC'd on every
  // interaction; they can open the same portal link. See the merge endpoint.
  additionalEmails      String[]       @default([])
  // When this record was consolidated into another, points at the survivor.
  // Merged records are hidden from the pipeline.
  mergedIntoId          String?
  contactPhone          String?
  contactRole           String?
  website               String?

  // Exhibitor on-site details (collected for the Exhibitor Table tier).
  registreeName         String?
  registreeEmail        String?
  dietary               String?
  accessibility         String?
  wantsLogo             Boolean        @default(false)
  exhibitorDetailsAt    DateTime?

  tier                  String
  customTierName        String?
  amountCents           Int
  donateFoodInstead     Boolean        @default(false)

  message               String?

  // In-kind (food/ASL) logistics, collected on the sponsor portal after they
  // accept: what they'll provide, day/meal, delivery, day-of contact, allergens,
  // setup (food) or coverage, interpreters, mode, materials (ASL). A flat
  // string map keyed by field; see LogisticsForm / the logistics save route.
  logistics             Json?

  status                String         @default("submitted")
  paid                  Boolean        @default(false)
  paidAt                DateTime?
  stripeSessionId       String?
  stripePaymentIntentId String?

  applicationToken      String         @unique

  inviteMessage         String?
  // VIP courtesy: when set (e.g. 20), checkout applies this percentage off the
  // chosen sponsorship level. Excludes exhibitor tables; applied at checkout.
  discountPercent       Int?
  invitedById           String?
  invitedAt             DateTime?
  lastSentAt            DateTime?
  // Set when the recipient uses the one-click unsubscribe. Suppresses all
  // further sends to this org and is honored before every send.
  unsubscribedAt        DateTime?

  adminNotes            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime?      @updatedAt

  events                SponsorEvent[]
  logo                  SponsorLogo?

  @@index([status])
  @@index([tier])
  @@map("lcc_sponsors")
  @@schema("lcc")
}

// Exhibitor/sponsor logo, stored out-of-row so the Sponsor list query never
// pulls the image bytes. One per sponsor; served via /api/sponsors/:id/logo.
model SponsorLogo {
  sponsorId String   @id
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  @@map("lcc_sponsor_logos")
  @@schema("lcc")
}

model SponsorEvent {
  id         String   @id @default(cuid())
  sponsorId  String
  type       String
  meta       String?
  actorEmail String?
  createdAt  DateTime @default(now())
  sponsor    Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("lcc_sponsor_events")
  @@schema("lcc")
}

// Outbound Call-for-Proposals recipients. One row per person we email the
// open CFP to, so the team can see who's been contacted, which variant
// (general vs. healthcare) went out, the send status, and resend.
model ProposalInvite {
  id            String   @id @default(cuid())
  email         String
  name          String?
  variant       String   @default("general") // "general" | "healthcare"
  customMessage String?

  status        String   @default("sent") // "sent" | "failed"
  sendError     String?
  sentCount     Int      @default(0)

  invitedById   String?
  invitedByEmail String?
  lastSentAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime? @updatedAt

  @@unique([email, variant])
  @@index([variant])
  @@map("lcc_proposal_invites")
  @@schema("lcc")
}

// A reusable discount code applied during conference registration. Codes are
// validated and the price is recomputed entirely server-side; the client
// never asserts a discount amount.
//
// The discount magnitude is set per attendance mode, so a single code can be
// worth, say, $15 off virtual and $30 off in-person. "kind" decides how the
// per-mode values are read:
//   kind = "fixed"   → virtualValue / inPersonValue are cents off
//   kind = "percent" → virtualValue / inPersonValue are percentage points
// A null value means the code does not apply to that mode; at least one is set.
model DiscountCode {
  id             String   @id @default(cuid())
  code           String   @unique // stored uppercased; matched case-insensitively
  description    String?  // internal label, e.g. "Partner org — NWU"

  kind           String   @default("fixed") // "fixed" | "percent"
  virtualValue   Int?     // cents (fixed) or percent points (percent); null = N/A for virtual
  inPersonValue  Int?     // cents (fixed) or percent points (percent); null = N/A for in-person

  // Optional constraints. Null = no limit.
  active         Boolean  @default(true)
  expiresAt      DateTime?
  maxRedemptions Int?     // null = unlimited

  // Denormalized tally of successful (paid) redemptions, kept in sync with
  // the redemption log so the dashboard can sort/filter without a join.
  redeemedCount  Int      @default(0)

  createdById    String?
  createdByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  redemptions    DiscountRedemption[]

  @@index([active])
  @@map("lcc_discount_codes")
  @@schema("lcc")
}

// One row per time a code is applied to a registration. Created as "applied"
// when the code is accepted at checkout, promoted to "redeemed" when payment
// clears in the webhook. This is the audit trail for tracking usage.
model DiscountRedemption {
  id              String   @id @default(cuid())
  codeId          String
  code            String   // snapshot of the code text at apply time
  attendeeId      String?
  attendeeEmail   String?
  attendanceMode  String?

  basePriceCents  Int
  discountCents   Int
  finalPriceCents Int

  status          String   @default("applied") // "applied" | "redeemed" | "voided"
  stripeSessionId String?
  redeemedAt      DateTime?
  createdAt       DateTime @default(now())

  discount        DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([attendeeEmail])
  @@map("lcc_discount_redemptions")
  @@schema("lcc")
}

// ---- Meeting booking (Calendly-style) -----------------------------------
// Team members publish availability; we send proposal submitters a booking
// link that pools the selected members' free times, and a confirmed booking
// creates a Zoom meeting on the assigned member's account.

// A recurring weekly availability rule for one team member, e.g. Mondays
// 09:00–12:00. Times are wall-clock in the member's own timezone (User.timezone).
model MemberAvailability {
  id         String   @id @default(cuid())
  userId     String
  weekday    Int      // 0 = Sunday … 6 = Saturday
  startMin   Int      // minutes from midnight, local to the member's tz (e.g. 540 = 09:00)
  endMin     Int      // minutes from midnight (must be > startMin)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_member_availability")
  @@schema("lcc")
}

// A one-off exception to the recurring rules for a member: either an extra
// opening ("add") or a blocked period ("block"), as an absolute UTC range.
model AvailabilityException {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("block") // "add" | "block"
  startAt   DateTime // absolute UTC
  endAt     DateTime
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_availability_exceptions")
  @@schema("lcc")
}

// An invitation to book a meeting. Pools the availability of memberIds and
// presents free slots to the invitee at /book/[token]. Optionally tied to a
// Presenter (a "proposed" submitter) but can also target a manual email.
model BookingInvite {
  id             String   @id @default(cuid())
  token          String   @unique

  inviteeName    String
  inviteeEmail   String
  presenterId    String?  // set when inviting an existing proposed presenter

  memberIds      String[] // User ids whose availability is pooled
  durationMin    Int      @default(30)
  title          String?  // e.g. "Conversation about your proposal"
  message        String?  // personal note shown on the booking page

  status         String   @default("sent") // "sent" | "booked" | "canceled" | "expired"
  expiresAt      DateTime?

  invitedById    String?
  invitedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime? @updatedAt

  booking        Booking?

  @@index([status])
  @@map("lcc_booking_invites")
  @@schema("lcc")
}

// A confirmed booking from an invite. assignedUserId is whoever was free for
// the chosen slot (pooled first-available) and hosts the Zoom meeting.
model Booking {
  id             String   @id @default(cuid())
  inviteId       String   @unique
  assignedUserId String

  startAt        DateTime // absolute UTC
  endAt          DateTime
  inviteeTz      String   // timezone the invitee booked in, for display

  zoomMeetingId  String?
  zoomJoinUrl    String?
  zoomStartUrl   String?
  zoomError      String?  // set if Zoom creation failed (booking still stands)

  status         String   @default("confirmed") // "confirmed" | "canceled"
  canceledAt     DateTime?
  createdAt      DateTime @default(now())

  invite         BookingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  assignedUser   User          @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)

  @@index([assignedUserId])
  @@index([startAt])
  @@map("lcc_bookings")
  @@schema("lcc")
}

// A single item on the conference program (single-track). Free-form: title and
// times are editable, with an optional loose reference to a Presenter so an
// admin can pre-fill from the confirmed list and then tweak.
model ScheduleSession {
  id            String    @id @default(cuid())
  title         String
  kind          String    @default("session") // session|keynote|panel|workshop|break|lunch|registration|networking
  description   String?
  presenterName String?
  presenterId   String?
  presenterIds  String[]  @default([])
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([startTime])
  @@map("lcc_schedule_sessions")
  @@schema("lcc")
}
