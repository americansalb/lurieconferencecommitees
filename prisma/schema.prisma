generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["lcc"]
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String
  role                   String                  @default("member")
  timezone               String                  @default("America/Chicago")
  icalToken              String?                 @unique
  createdAt              DateTime                @default(now())
  committees             CommitteeMember[]
  discussions            Discussion[]
  posts                  Post[]
  tasks                  Task[]                  @relation("assignee")
  files                  CommitteeFile[]
  devices                Device[]
  mobileSessions         MobileSession[]
  notificationPrefs      NotificationPreference?
  notificationLog        NotificationLog[]
  scheduledNotifs        ScheduledNotification[]
  discussionReads        DiscussionRead[]
  mentions               Mention[]
  availability           MemberAvailability[]
  availabilityExceptions AvailabilityException[]
  bookings               Booking[]

  @@map("lcc_users")
  @@schema("lcc")
}

model Committee {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String
  color       String            @default("#3B82F6")
  icon        String            @default("users")
  members     CommitteeMember[]
  events      Event[]
  discussions Discussion[]
  tasks       Task[]
  files       CommitteeFile[]

  @@map("lcc_committees")
  @@schema("lcc")
}

model CommitteeMember {
  id          String    @id @default(cuid())
  userId      String
  committeeId String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@unique([userId, committeeId])
  @@map("lcc_committee_members")
  @@schema("lcc")
}

model Event {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  startTime   DateTime
  endTime     DateTime
  duration    Int       @default(60)
  timezone    String    @default("America/Chicago")
  recurring   Boolean   @default(false)
  meetingUrl  String?
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@map("lcc_events")
  @@schema("lcc")
}

model Discussion {
  id          String           @id @default(cuid())
  committeeId String?
  title       String
  authorId    String
  isPinned    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  committee   Committee?       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts       Post[]
  reads       DiscussionRead[]

  @@map("lcc_discussions")
  @@schema("lcc")
}

model Task {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  description String    @default("")
  status      String    @default("todo")
  priority    String    @default("medium")
  progress    Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  color       String?
  url         String?
  assigneeId  String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("lcc_tasks")
  @@schema("lcc")
}

model CommitteeFile {
  id          String    @id @default(cuid())
  committeeId String
  title       String
  url         String
  type        String    @default("link")
  addedById   String
  createdAt   DateTime  @default(now())
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@map("lcc_committee_files")
  @@schema("lcc")
}

model Post {
  id           String     @id @default(cuid())
  discussionId String
  authorId     String
  body         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions     Mention[]

  @@map("lcc_posts")
  @@schema("lcc")
}

model DiscussionRead {
  id           String     @id @default(cuid())
  userId       String
  discussionId String
  lastReadAt   DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@index([discussionId])
  @@map("lcc_discussion_reads")
  @@schema("lcc")
}

model Mention {
  id           String    @id @default(cuid())
  userId       String
  postId       String
  discussionId String
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([postId])
  @@map("lcc_mentions")
  @@schema("lcc")
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  platform   String
  pushToken  String   @unique
  appVersion String?
  deviceName String?
  locale     String?
  timezone   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_devices")
  @@schema("lcc")
}

model MobileSession {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_mobile_sessions")
  @@schema("lcc")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  String   @default("{}")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lcc_notification_preferences")
  @@schema("lcc")
}

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String
  channel String
  title   String
  body    String
  payload String?
  sentAt  DateTime @default(now())
  status  String   @default("sent")
  error   String?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@map("lcc_notification_log")
  @@schema("lcc")
}

model ScheduledNotification {
  id           String    @id @default(cuid())
  userId       String
  channel      String
  title        String
  body         String
  payload      String?
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  source       String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([source])
  @@map("lcc_scheduled_notifications")
  @@schema("lcc")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  @@index([userId])
  @@map("lcc_password_reset_tokens")
  @@schema("lcc")
}

model Presenter {
  id          String  @id @default(cuid())
  // Not unique: one person may submit more than one proposal (each proposal is
  // its own Presenter row with its own confirm token). Indexed for lookups.
  email       String
  name        String
  affiliation String?
  jobTitle    String?
  pronouns    String?
  phone       String?

  role                String?
  talkTitle           String?
  talkAbstract        String?
  sessionFormat       String?
  sessionTrack        String?
  sessionLength       String?
  qaLength            String?
  coPresenters        String?
  preferredDay        String?
  learningObjectives  String?
  honorariumAmount    Int?
  travelReimbursement Int?
  presenterMessage    String?

  bio            String?
  headshotData   Bytes?
  headshotMime   String?
  websiteUrl     String?
  linkedinUrl    String?
  twitterHandle  String?
  facebookUrl    String?
  instagramUrl   String?
  otherSocialUrl String?

  avNotes        String?
  needsMic       Boolean @default(false)
  needsProjector Boolean @default(false)
  needsAudio     Boolean @default(false)
  needsInternet  Boolean @default(false)
  needsRecording Boolean @default(false)
  needsClicker   Boolean @default(false)

  travelMode      String?
  travelOrigin    String?
  travelArrival   DateTime?
  travelDeparture DateTime?
  needsHotel      Boolean   @default(false)
  hotelNotes      String?
  needsParking    Boolean   @default(false)

  dietary            String?
  allergies          String?
  accessibilityNeeds String?
  emergencyContact   String?

  agreedToRecord     Boolean   @default(false)
  // Set when the presenter has a prior written agreement from AALB & Lurie that
  // their session will NOT be recorded. Satisfies the recording permission in
  // place of agreedToRecord, so recording consent is optional for them.
  recordingWaived    Boolean   @default(false)
  agreedToPhoto      Boolean   @default(false)
  agreedToTerms      Boolean   @default(false)
  agreedToCe         Boolean   @default(false)
  agreedToHeadshot   Boolean   @default(false)
  policiesAcceptedAt DateTime?

  status           String    @default("invited")
  declineReason    String?
  requestedChanges String?
  token            String    @unique
  invitedAt        DateTime  @default(now())
  confirmedAt      DateTime?

  // When we confirmed this presenter as an attendee too and sent them their
  // attendee portal link. Presenters attend free; this only tracks that the
  // note went out, so a second run doesn't mail them twice.
  attendeeInvitedAt DateTime?
  lastSentAt        DateTime?
  adminNotes        String?
  invitedById       String?

  // Presentation-deck collection: when we first asked for their slides and
  // how many reminder emails have gone out since. The deck itself lives in
  // PresenterSlide so list queries never touch file bytes.
  slidesRequestedAt DateTime?
  slidesRemindCount Int       @default(0)
  // Run-of-show notes typed next to the deck ("pass the mic to the audience
  // for Q&A", "the video has sound"). On Presenter, not PresenterSlide, so
  // notes survive even when the deck itself arrives by email.
  slideNotes        String?

  // Paying them afterwards: when we asked where to send the honorarium
  // cheque, and the address they sent back if they replied with one rather
  // than invoicing. Kept here so a second run does not ask twice.
  honorariumAskedAt DateTime?
  mailingAddress    String?

  // The feedback share page's own token, distinct from the portal token so a
  // shared feedback link never opens the portal (honorarium, personal data)
  // and can be revoked without cutting the presenter off from their portal.
  feedbackToken String? @unique

  events   PresenterEvent[]
  slide    PresenterSlide?
  feedback FeedbackResponse[]

  @@index([email])
  @@map("lcc_presenters")
  @@schema("lcc")
}

// A presenter's talk deck: either an uploaded file (PowerPoint / Keynote /
// PDF, size capped) or a pasted link (Google Slides etc.). One per
// presenter, out-of-row so Presenter list queries never pull file bytes.
// Uploaded via the tokenized portal; served to the team via
// /api/presenters/[id]/slides. Decks too big to upload are emailed to
// contact@aalb.org instead (the portal says so), so this row may stay empty
// for a presenter who has genuinely delivered.
model PresenterSlide {
  presenterId String                @id
  presenter   Presenter             @relation(fields: [presenterId], references: [id], onDelete: Cascade)
  fileName    String?
  mime        String?
  sizeBytes   Int?
  // Decks uploaded before the move to chunked storage still live here. New
  // uploads leave it null and write PresenterSlideChunk rows instead.
  data        Bytes?
  linkUrl     String?
  // Set when a team member uploaded this for a presenter who could not, so a
  // deck on file is never mistaken for a presenter who answered.
  uploadedBy  String?
  // Which upload the current chunks belong to. A second upload starting for the
  // same presenter takes this over, and the first one notices and gives up
  // rather than leaving the two spliced together.
  uploadId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime?             @updatedAt
  chunks      PresenterSlideChunk[]

  @@map("lcc_presenter_slides")
  @@schema("lcc")
}

/// One slice of an uploaded deck.
///
/// Files are stored in pieces rather than as one column because appending to a
/// single bytea rewrites the whole value every time: 100 MB took 34.5 seconds
/// that way and 3.5 seconds as rows, because the cost stops being quadratic.
model PresenterSlideChunk {
  presenterId String
  uploadId    String
  seq         Int
  data        Bytes
  slide       PresenterSlide @relation(fields: [presenterId], references: [presenterId], onDelete: Cascade)

  @@id([presenterId, uploadId, seq])
  @@map("lcc_presenter_slide_chunks")
  @@schema("lcc")
}

/// One feedback-form response about one session.
///
/// A spreadsheet row that rated several sessions is split into several of
/// these at import, so the storage and the statistics never care which shape
/// the form was. `data` keeps the untouched row for auditing; `ratings` and
/// `comments` hold just the mapped answers, keyed by question label.
model FeedbackResponse {
  id           String     @id @default(cuid())
  /// Which import batch brought it in, so a re-import replaces its own rows.
  importId     String
  /// The session as the form named it, before any matching.
  sessionLabel String
  /// Matched presenter. Null until matched; unmatched rows appear only in the
  /// admin fix-up list, never on a share page.
  presenterId  String?
  presenter    Presenter? @relation(fields: [presenterId], references: [id], onDelete: SetNull)
  /// Numeric answers, keyed by question label.
  ratings      Json
  /// Free-text answers, keyed by question label.
  comments     Json
  /// Comment keys hidden from the presenter page: {label: {by, at}}.
  hiddenKeys   Json       @default("{}")
  /// The raw row as imported, untouched.
  data         Json
  submittedAt  DateTime?
  importedAt   DateTime   @default(now())

  @@index([presenterId])
  @@index([importId])
  @@map("lcc_feedback_responses")
  @@schema("lcc")
}

model PresenterEvent {
  id          String    @id @default(cuid())
  presenterId String
  type        String
  meta        String?
  actorEmail  String?
  createdAt   DateTime  @default(now())
  presenter   Presenter @relation(fields: [presenterId], references: [id], onDelete: Cascade)

  @@map("lcc_presenter_events")
  @@schema("lcc")
}

model Attendee {
  id               String  @id @default(cuid())
  email            String  @unique
  firstName        String
  lastName         String
  phone            String?
  affiliation      String?
  primaryLanguages String?

  // AALB training cohort (medical-interpreter session), for imported students.
  // `cohort` is the label ("141"); `cohortOrder` is the numeric session number
  // used to sort newest-first and to filter by session. Null for non-students.
  cohort      String?
  cohortOrder Int?

  // 2024 conference relationship, for the returning reunion letters: "paid"
  // (registered and paid in 2024), "attempted" (started a checkout, never
  // finished), or "lead" (left their info only). attended2024Mode is how they
  // joined or planned to join: "in-person" | "virtual". Null for everyone else.
  returning2024    String?
  attended2024Mode String?

  attendanceMode     String?
  // One-day virtual ticket: "sat" or "sun" when the attendee registered for a
  // single day (66% price, virtual only); null means both days.
  attendDay          String?
  needsParking       Boolean?
  accessibilityNotes String?
  dietary            String?
  notes              String?

  discountPercent Int  @default(25)
  basePriceCents  Int?
  finalPriceCents Int?

  // Shared discount code applied at registration (distinct from the
  // per-person discountPercent used for personal invites). Set when a code
  // is accepted; the redemption row is the authoritative audit record.
  discountCodeId    String?
  discountCode      String?
  discountCodeCents Int?    @default(0)

  paid                  Boolean   @default(false)
  paidAt                DateTime?
  stripeSessionId       String?
  stripePaymentIntentId String?

  status        String  @default("queued")
  declineReason String?

  inviteToken    String    @unique
  inviteMessage  String?
  inviteTemplate String    @default("standard")
  invitedById    String?
  invitedAt      DateTime?
  lastSentAt     DateTime?
  viewedAt       DateTime?
  confirmedAt    DateTime?
  declinedAt     DateTime?

  // Finish-registration reminders ("nudges"): how many this person has been
  // sent and when the last one was queued. Drives the "1st reminder" chip on
  // the attendee list and lets the bulk nudge target never-reminded people.
  nudgeCount   Int       @default(0)
  lastNudgedAt DateTime?

  // Created by the emails-only deliverability test, not a real invitee. Kept
  // out of the attendee pipeline and all email metrics so test traffic never
  // skews the numbers.
  isTest Boolean @default(false)

  // Set when this person is attending under a sponsor's or exhibitor's
  // allocation. compFromSponsor marks the ones using a free ticket included
  // with the tier, as opposed to extra staff who paid their own way.
  sponsorId       String?
  compFromSponsor Boolean  @default(false)
  sponsor         Sponsor? @relation("SponsorTeam", fields: [sponsorId], references: [id], onDelete: SetNull)

  // Set when the recipient uses one-click unsubscribe. Suppresses all further
  // sends to this person and is honored before every send.
  unsubscribedAt DateTime?

  // When their personalized conference guide was last emailed, so a second run
  // catches up late registrants instead of mailing everyone twice.
  guideSentAt DateTime?

  // The second, in-person-only letter: the hospital, the city, and the sign-up
  // form for the tour and the Saturday social. Tracked separately from
  // guideSentAt so sending one never suppresses the other.
  chicagoGuideSentAt DateTime?

  // The virtual counterpart of the guide: Zoom links, sign-in times, and CEU
  // rules, emailed to paid virtual attendees. Its own stamp so a second run
  // catches up late registrants instead of mailing everyone twice.
  virtualInfoSentAt DateTime?

  adminNotes String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  events AttendeeEvent[]

  @@index([status])
  @@index([sponsorId])
  @@map("lcc_attendees")
  @@schema("lcc")
}

model AttendeeEvent {
  id         String   @id @default(cuid())
  attendeeId String
  type       String
  meta       String?
  actorEmail String?
  createdAt  DateTime @default(now())
  attendee   Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@map("lcc_attendee_events")
  @@schema("lcc")
}

model EmailQueue {
  id            String    @id @default(cuid())
  batchId       String?
  recipientType String    @default("attendee")
  recipientId   String?
  to            String
  subject       String
  html          String
  textBody      String?
  // JSON array of Resend attachment specs ({filename, path}) applied at send
  // time. `path` is a public URL (e.g. the site's /program.pdf) so rows stay
  // small and the file is fetched fresh on delivery. Null = no attachments.
  attachments   String?
  scheduledFor  DateTime
  status        String    @default("pending")
  attempts      Int       @default(0)
  sentAt        DateTime?
  lastError     String?
  resendId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([status, scheduledFor])
  @@index([batchId])
  @@index([recipientType, recipientId])
  @@map("lcc_email_queue")
  @@schema("lcc")
}

/// Applications for the ten free in-person seats set aside for AALB alumni and
/// current students. Kept apart from Attendee: an application is not a
/// registration, and most of these people will not become one. On award, the
/// team creates or comps their attendee record separately.
model ScholarshipApplication {
  id        String  @id @default(cuid())
  email     String
  firstName String
  lastName  String
  phone     String?

  /// How the roster classified them when they applied: "alumni", "student", or
  /// "unverified" when they applied without matching and asked us to check.
  standing String
  /// Training session number from the roster, when we have one.
  cohort   String?

  /// Their answers. Long-form, because the point is to read them.
  currentRole    String?
  languages      String?
  whyAttend      String  @db.Text
  barrierSeen    String  @db.Text
  whatTheyWillDo String  @db.Text
  costBarrier    String? @db.Text
  accessibility  String?
  dietary        String?

  /// Set when they cannot travel and want the virtual seat instead.
  virtualInstead Boolean @default(false)

  status      String    @default("submitted")
  reviewNotes String?
  score       Int?
  decidedAt   DateTime?
  decidedBy   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([email])
  @@index([status])
  @@map("lcc_scholarship_applications")
  @@schema("lcc")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("lcc_system_settings")
  @@schema("lcc")
}

model Sponsor {
  id               String   @id @default(cuid())
  companyName      String
  contactName      String
  contactEmail     String
  // Co-applicants merged into this profile: extra emails CC'd on every
  // interaction; they can open the same portal link. See the merge endpoint.
  additionalEmails String[] @default([])
  // When this record was consolidated into another, points at the survivor.
  // Merged records are hidden from the pipeline.
  mergedIntoId     String?
  contactPhone     String?
  contactRole      String?
  website          String?

  // Exhibitor on-site details (collected for the Exhibitor Table tier).
  registreeName      String?
  registreeEmail     String?
  dietary            String?
  accessibility      String?
  wantsLogo          Boolean   @default(false)
  exhibitorDetailsAt DateTime?

  tier              String
  customTierName    String?
  amountCents       Int
  donateFoodInstead Boolean @default(false)

  message String?

  // In-kind (food/ASL) logistics, collected on the sponsor portal after they
  // accept: what they'll provide, day/meal, delivery, day-of contact, allergens,
  // setup (food) or coverage, interpreters, mode, materials (ASL). A flat
  // string map keyed by field; see LogisticsForm / the logistics save route.
  logistics Json?

  status                String    @default("submitted")
  paid                  Boolean   @default(false)
  paidAt                DateTime?
  stripeSessionId       String?
  stripePaymentIntentId String?

  applicationToken String @unique

  // Shareable link for the sponsor's own team to register themselves. Kept
  // separate from applicationToken so forwarding it around never exposes the
  // payment portal. Null until the team invite is first sent.
  teamToken     String?   @unique
  teamInvitedAt DateTime?

  // Overrides the tier's ticketsIncluded for this organization only. Null
  // means use the tier default. Set it when a deal differs from the standard
  // level, e.g. a donated table where the staff still buy their own tickets.
  ticketsIncluded Int?

  // Payment chasing for an accepted sponsor who has not paid yet.
  // Count is shown on the row so nobody gets nagged twice by accident.
  paymentRemindedAt  DateTime?
  paymentRemindCount Int       @default(0)
  // When their personalized exhibitor guide was last emailed.
  guideSentAt        DateTime?

  inviteMessage   String?
  // VIP courtesy: when set (e.g. 20), checkout applies this percentage off the
  // chosen sponsorship level. Excludes exhibitor tables; applied at checkout.
  discountPercent Int?
  invitedById     String?
  invitedAt       DateTime?
  lastSentAt      DateTime?
  // Set when the recipient uses the one-click unsubscribe. Suppresses all
  // further sends to this org and is honored before every send.
  unsubscribedAt  DateTime?

  adminNotes String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  events        SponsorEvent[]
  logo          SponsorLogo?
  // People attending under this partner: their included tickets plus any
  // colleagues who registered through the shared team link.
  teamAttendees Attendee[]     @relation("SponsorTeam")

  @@index([status])
  @@index([tier])
  @@map("lcc_sponsors")
  @@schema("lcc")
}

// Exhibitor/sponsor logo, stored out-of-row so the Sponsor list query never
// pulls the image bytes. One per sponsor; served via /api/sponsors/:id/logo.
model SponsorLogo {
  sponsorId String    @id
  sponsor   Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  fileName  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("lcc_sponsor_logos")
  @@schema("lcc")
}

model SponsorEvent {
  id         String   @id @default(cuid())
  sponsorId  String
  type       String
  meta       String?
  actorEmail String?
  createdAt  DateTime @default(now())
  sponsor    Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@map("lcc_sponsor_events")
  @@schema("lcc")
}

// Outbound Call-for-Proposals recipients. One row per person we email the
// open CFP to, so the team can see who's been contacted, which variant
// (general vs. healthcare) went out, the send status, and resend.
model ProposalInvite {
  id            String  @id @default(cuid())
  email         String
  name          String?
  variant       String  @default("general") // "general" | "healthcare"
  customMessage String?

  status    String  @default("sent") // "sent" | "failed"
  sendError String?
  sentCount Int     @default(0)

  invitedById    String?
  invitedByEmail String?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  @@unique([email, variant])
  @@index([variant])
  @@map("lcc_proposal_invites")
  @@schema("lcc")
}

// A reusable discount code applied during conference registration. Codes are
// validated and the price is recomputed entirely server-side; the client
// never asserts a discount amount.
//
// The discount magnitude is set per attendance mode, so a single code can be
// worth, say, $15 off virtual and $30 off in-person. "kind" decides how the
// per-mode values are read:
//   kind = "fixed"   → virtualValue / inPersonValue are cents off
//   kind = "percent" → virtualValue / inPersonValue are percentage points
// A null value means the code does not apply to that mode; at least one is set.
model DiscountCode {
  id          String  @id @default(cuid())
  code        String  @unique // stored uppercased; matched case-insensitively
  description String? // internal label, e.g. "Partner org — NWU"

  kind          String @default("fixed") // "fixed" | "percent"
  virtualValue  Int? // cents (fixed) or percent points (percent); null = N/A for virtual
  inPersonValue Int? // cents (fixed) or percent points (percent); null = N/A for in-person

  // Optional constraints. Null = no limit.
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxRedemptions Int? // null = unlimited

  // Denormalized tally of successful (paid) redemptions, kept in sync with
  // the redemption log so the dashboard can sort/filter without a join.
  redeemedCount Int @default(0)

  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  redemptions DiscountRedemption[]

  @@index([active])
  @@map("lcc_discount_codes")
  @@schema("lcc")
}

// One row per time a code is applied to a registration. Created as "applied"
// when the code is accepted at checkout, promoted to "redeemed" when payment
// clears in the webhook. This is the audit trail for tracking usage.
model DiscountRedemption {
  id             String  @id @default(cuid())
  codeId         String
  code           String // snapshot of the code text at apply time
  attendeeId     String?
  attendeeEmail  String?
  attendanceMode String?

  basePriceCents  Int
  discountCents   Int
  finalPriceCents Int

  status          String    @default("applied") // "applied" | "redeemed" | "voided"
  stripeSessionId String?
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())

  discount DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([attendeeEmail])
  @@map("lcc_discount_redemptions")
  @@schema("lcc")
}

// ---- Meeting booking (Calendly-style) -----------------------------------
// Team members publish availability; we send proposal submitters a booking
// link that pools the selected members' free times, and a confirmed booking
// creates a Zoom meeting on the assigned member's account.

// A recurring weekly availability rule for one team member, e.g. Mondays
// 09:00–12:00. Times are wall-clock in the member's own timezone (User.timezone).
model MemberAvailability {
  id        String   @id @default(cuid())
  userId    String
  weekday   Int // 0 = Sunday … 6 = Saturday
  startMin  Int // minutes from midnight, local to the member's tz (e.g. 540 = 09:00)
  endMin    Int // minutes from midnight (must be > startMin)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_member_availability")
  @@schema("lcc")
}

// A one-off exception to the recurring rules for a member: either an extra
// opening ("add") or a blocked period ("block"), as an absolute UTC range.
model AvailabilityException {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @default("block") // "add" | "block"
  startAt   DateTime // absolute UTC
  endAt     DateTime
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("lcc_availability_exceptions")
  @@schema("lcc")
}

// An invitation to book a meeting. Pools the availability of memberIds and
// presents free slots to the invitee at /book/[token]. Optionally tied to a
// Presenter (a "proposed" submitter) but can also target a manual email.
model BookingInvite {
  id    String @id @default(cuid())
  token String @unique

  inviteeName  String
  inviteeEmail String
  presenterId  String? // set when inviting an existing proposed presenter

  memberIds   String[] // User ids whose availability is pooled
  durationMin Int      @default(30)
  title       String? // e.g. "Conversation about your proposal"
  message     String? // personal note shown on the booking page

  status    String    @default("sent") // "sent" | "booked" | "canceled" | "expired"
  expiresAt DateTime?

  invitedById    String?
  invitedByEmail String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  booking Booking?

  @@index([status])
  @@map("lcc_booking_invites")
  @@schema("lcc")
}

// A confirmed booking from an invite. assignedUserId is whoever was free for
// the chosen slot (pooled first-available) and hosts the Zoom meeting.
model Booking {
  id             String @id @default(cuid())
  inviteId       String @unique
  assignedUserId String

  startAt   DateTime // absolute UTC
  endAt     DateTime
  inviteeTz String // timezone the invitee booked in, for display

  zoomMeetingId String?
  zoomJoinUrl   String?
  zoomStartUrl  String?
  zoomError     String? // set if Zoom creation failed (booking still stands)

  status     String    @default("confirmed") // "confirmed" | "canceled"
  canceledAt DateTime?
  createdAt  DateTime  @default(now())

  invite       BookingInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  assignedUser User          @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)

  @@index([assignedUserId])
  @@index([startAt])
  @@map("lcc_bookings")
  @@schema("lcc")
}

// A single item on the conference program (single-track). Free-form: title and
// times are editable, with an optional loose reference to a Presenter so an
// admin can pre-fill from the confirmed list and then tweak.
model ScheduleSession {
  id            String    @id @default(cuid())
  title         String
  kind          String    @default("session") // session|keynote|panel|workshop|break|lunch|registration|networking
  description   String?
  presenterName String?
  presenterId   String?
  presenterIds  String[]  @default([])
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([startTime])
  @@map("lcc_schedule_sessions")
  @@schema("lcc")
}

// An ASL interpreter who accepted (or is filling out) the public invitation
// at /asl for the two conference days. Availability is stored as UTC ISO
// hour-start strings from src/lib/asl-slots.ts, so the row is unambiguous no
// matter what timezone the interpreter verified. Speed figures come from the
// background connection check that runs while they complete the form; they
// are null when every sample failed (which is itself signal).
model AslInterpreter {
  id                 String    @id @default(cuid())
  fullName           String
  email              String    @unique
  phone              String?
  // Certification keys from the form (rid, bei, eipa, state, other, none).
  // ridNumber is asked for, and required, only when "rid" is among them.
  certifications     String[]  @default([])
  certificationOther String?
  ridNumber          String?
  yearsFluent        Int
  yearsInterpreting  Int
  timezone           String
  hourlyCents        Int
  availability       String[]  @default([])
  notes              String?
  speedDownMbps      Float?
  speedUpMbps        Float?
  speedPingMs        Float?
  speedTestSeconds   Int?
  speedTestDetail    String?
  // "submitted" until a teammate clicks Accept on /asl-team, which sends the
  // interpreter their confirmation email and flips this to "accepted".
  // Nothing is emailed to the interpreter automatically on submission.
  status             String    @default("submitted")
  acceptedAt         DateTime?
  acceptedById       String?
  userAgent          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime? @updatedAt

  @@map("lcc_asl_interpreters")
  @@schema("lcc")
}

// An ambassador: an educator, program director, or association leader we ask
// to SHARE the conference with their students/members (not to sponsor). Each
// carries a personal 20% discount code (created in DiscountCode at queue time,
// valid through Aug 10) whose redemptions tell us who actually drove signups.
model Ambassador {
  id             String    @id @default(cuid())
  orgName        String
  // Person to greet; "" greets the organization.
  contactName    String    @default("")
  email          String    @unique
  website        String?
  // Who they reach, e.g. "healthcare-interpreting certificate students".
  audience       String?
  // The individually written "why we thought of you" paragraph in the letter.
  note           String?
  // Their shareable discount code (uppercase; row in DiscountCode by `code`).
  code           String    @unique
  // pending (loaded) -> queued (in email queue) -> invited (letter sent)
  status         String    @default("pending")
  // Unsubscribe + share-link token, unguessable.
  token          String    @unique
  invitedAt      DateTime?
  lastSentAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  @@index([status])
  @@map("lcc_ambassadors")
  @@schema("lcc")
}
